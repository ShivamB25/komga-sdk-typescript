{
  "name": "komga-sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for the Komga media server API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "docs:serve": "typedoc && npx serve docs/api"
  },
  "dependencies": {
    "ky": "^2.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "typedoc": "^0.28.17",
    "typescript": "^6.0.2",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "komga",
    "api",
    "sdk",
    "typescript",
    "media-server"
  ],
  "license": "MIT",
  "author": "ShivamB25",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShivamB25/komga-sdk-typescript.git"
  },
  "homepage": "https://github.com/ShivamB25/komga-sdk-typescript#readme",
  "bugs": {
    "url": "https://github.com/ShivamB25/komga-sdk-typescript/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
