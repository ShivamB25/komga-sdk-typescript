{
  "name": "komga-sdk",
  "version": "2.0.0",
  "description": "TypeScript SDK for the Komga media server API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./types": {
      "types": "./dist/generated/types.gen.d.ts",
      "import": "./dist/generated/types.gen.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate": "bun scripts/generate.ts",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "docs:serve": "typedoc && npx serve docs/api"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typedoc": "^0.28.20",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "komga",
    "api",
    "sdk",
    "typescript",
    "media-server"
  ],
  "license": "MIT",
  "author": "ShivamB25",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShivamB25/komga-sdk-typescript.git"
  },
  "homepage": "https://github.com/ShivamB25/komga-sdk-typescript#readme",
  "bugs": {
    "url": "https://github.com/ShivamB25/komga-sdk-typescript/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
